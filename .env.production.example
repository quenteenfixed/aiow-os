# AIOW 生产环境配置模板
# 复制为 .env.production 并填写真实值；切勿提交真实 .env.production 到 git

# ===== App =====
LOG_LEVEL=info
CORS_ORIGINS=https://aiow.example.com
DOCS_ENABLED=false

# ===== Database =====
POSTGRES_USER=aiow
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=aiow

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_here

# ===== JWT (>=32 字符，随机串) =====
# 生成：openssl rand -hex 48
JWT_SECRET=CHANGE_ME_random_64_char_hex_string_please

# ===== LLM =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# ===== 监控 =====
METRICS_ENABLED=true
SLOW_REQUEST_THRESHOLD_MS=1000

# ===== Gunicorn =====
GUNICORN_WORKERS=4
